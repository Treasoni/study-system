# === Project Identity ===
APP_NAME=study-system
APP_ENV=development
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# === Workspace Paths ===
# Paths are relative to the project root. Do not commit machine-specific absolute paths.
WORKSPACE_PATH=./workspace
OUTPUT_PATH=${WORKSPACE_PATH}/output
TEMP_PATH=${WORKSPACE_PATH}/tmp

# Study System note workflow paths.
NOTES_OUTPUT_PATH=${OUTPUT_PATH}
CHAPTERS_PATH=${WORKSPACE_PATH}/chapters
WORKFLOW_RUNS_PATH=${WORKSPACE_PATH}/workflow-runs

# Optional Obsidian publishing. Leave blank unless you want to publish outside this project.
OBSIDIAN_VAULT_PATH=
OBSIDIAN_NOTES_DIR=
OBSIDIAN_MOC_PATH=

# === Runtime Behavior ===
LOG_LEVEL=info
DEBUG=false
DRY_RUN=false
AUTO_CONFIRM=false

# Project-local Codex hook behavior. Keep disabled unless you explicitly want automation.
CODEX_AUTO_GIT=0
CODEX_AUTO_GIT_PUSH=0

# === LLM / Research Providers ===
# Fill only the providers used by the current project. Never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MINIMAX_API_KEY=

# Default model names are examples; adjust per project and provider.
DEFAULT_LLM_PROVIDER=
DEFAULT_LLM_MODEL=
EMBEDDING_MODEL=

# === Optional Application Services ===
# Keep these blank unless the project actually uses them.
DATABASE_URL=
REDIS_URL=
VECTOR_DATABASE_URL=
STORAGE_BUCKET=

# === Observability ===
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# === Local Overrides ===
# Put personal values in .env or .env.local, not in this file.
