# === Application ===
APP_NAME=study-system
APP_PORT=3000
NODE_ENV=development

# === Project Root ===
# 项目根目录，所有相对路径基于此
PROJECT_ROOT=/path/to/your/study-system

# === Storage Paths ===
# 研究笔记缓存目录
RESEARCH_NOTES_DIR=${PROJECT_ROOT}/research_notes

# === API Keys ===
# MiniMax API - get from https://platform.minimax.io
MINIMAX_API_KEY=your-key-here

# === Debug ===
DEBUG=false
